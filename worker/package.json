{
  "name": "priestess-verification-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Priestess Verification on Cloudflare Workers (verify.rakko.cn)",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "node web/build.mjs",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "deploy": "wrangler deploy",
    "test": "vitest run --config vitest.config.js",
    "acceptance": "node scripts/acceptance.mjs",
    "bench:cpu": "node scripts/cpu-bench.mjs",
    "bench:wall": "node scripts/wall-bench.mjs",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.140.0"
  },
  "overrides": {
    "workerd": "1.20260925.2"
  }
}
