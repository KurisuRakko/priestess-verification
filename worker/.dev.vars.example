# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` and replace both values with long random strings, e.g.
#   openssl rand -hex 32
# `.dev.vars` is gitignored; production values are set with
# `wrangler secret put CAP_SECRET` / `wrangler secret put SITEVERIFY_SECRET`.
CAP_SECRET=dev-cap-secret-change-me-0123456789abcdef
SITEVERIFY_SECRET=dev-siteverify-secret-change-me-0123456789abcdef
# Optional: key for the server-side gate's pass cookie (`__pv_pass`). When
# unset it is derived as HMAC-SHA256(SITEVERIFY_SECRET, "gate-cookie").
# GATE_COOKIE_SECRET=dev-gate-cookie-secret-change-me-0123456789abcdef
