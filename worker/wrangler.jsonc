{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "priestess-verification",
  "main": "src/index.js",
  // Deployment compatibility date. `npm run dev`, `npm test` and
  // `wrangler deploy` all use this single date: the newest published workerd
  // (1.20260925.2) rejects anything newer at startup, so the date is pinned to
  // the runtime the Worker actually ships on.
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://verify.rakko.cn",
    // /admin signs in through Priestess (Phainon app `priestess-verification`)
    // and then only lets these Priestess subs in (comma separated; empty =
    // nobody).
    "PRIESTESS_API_BASE": "https://api.rakko.cn/auth/priestess/oidc",
    "PRIESTESS_APP_ID": "priestess-verification",
    "ADMIN_ALLOWED_SUBS": "plu_UUHsG7WuUqDXh4R6"
  },
  // `import capMinJs from "../../widget/src/cap.min.js"` must embed the exact
  // bytes of the repo's build artifact, not evaluate it as a module, and
  // `/cap_wasm_bg.wasm` must be served as raw bytes (wrangler's built-in
  // `.wasm` rule would compile it into a WebAssembly.Module instead). The three
  // mascot images are imported as raw bytes for the same reason — an image
  // import must never be parsed as a module. All rules fall through so the
  // defaults still apply to every other file. The showcase and gate pages
  // inline their React bundles (`src/generated/*.client.js` + `*.css`, built
  // by `npm run build:web` from `web/`) as text too, and the admin console
  // inlines its own CSS, `admin.client.js` and the Rakko Design vendor CSS
  // (the ripple modules are served at /admin/design/*.js): none of it is Worker code.
  "rules": [
    { "type": "Data", "globs": ["**/cap_wasm_bg.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/mascot/*.webp"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.min.js"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.css"], "fallthrough": true },
    {
      "type": "Text",
      "globs": [
        "**/*.client.js",
        "**/vendor/rakko-design/design-system/src/ripple*.js"
      ],
      "fallthrough": true
    }
  ],
  // capjs-core dynamically imports these for instrumentation obfuscation levels
  // >= 4. Neither can run in workerd, so both are stubbed and the import
  // rejects into instrumentation.js's clean fallback.
  "alias": {
    "esbuild": "./src/stubs/esbuild.js",
    "javascript-obfuscator": "./src/stubs/javascript-obfuscator.js"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TOKEN_STORE", "class_name": "TokenStore" },
      { "name": "SITE_REGISTRY", "class_name": "SiteRegistry" },
      { "name": "STATS_STORE", "class_name": "StatsStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TokenStore"] },
    { "tag": "v2", "new_sqlite_classes": ["SiteRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["StatsStore"] }
  ],
  // Per-IP limits (see `src/stats.js`): challenges, and redeems plus gate
  // passes. Counted per Cloudflare location and approximate by design.
  // `namespace_id` must be unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "RL_CHALLENGE",
      "namespace_id": "7301",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_REDEEM",
      "namespace_id": "7302",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "verify.rakko.cn", "custom_domain": true }],
  "observability": { "enabled": true }
}
