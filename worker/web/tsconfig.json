{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    /*
     * Mirrors resolve.alias in vite.config.ts (tsc does not read the Vite
     * config; change both together). vendor/rakko-design/ is generated by
     * scripts/sync-design.sh.
     */
    "paths": {
      "@rakko/react/styles.css": ["../../vendor/rakko-design/react/src/styles.css"],
      "@rakko/react": ["../../vendor/rakko-design/react/src/index.ts"],
      "@rakko/design-system/tokens.css": ["../../vendor/rakko-design/tokens.generated.css"],
      "@rakko/design-system/ripple": ["../../vendor/rakko-design/design-system/src/ripple"],
      "@rakko/design-system/context-action": ["../../vendor/rakko-design/design-system/src/context-action"],
      // The vendor copy lives outside worker/, where no node_modules is in
      // reach of its imports; vite.config.ts handles the same with `dedupe`.
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"],
      "@base-ui/react/*": ["../node_modules/@base-ui/react/*"]
    },
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["src", "../../vendor/rakko-design/react/src"]
}
